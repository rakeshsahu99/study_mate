# FastAPI AI Microservice Environment Variables (ai-service/.env)

# 1. Google Gemini API Key (Get free key at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Supabase Database Configuration (Requires pgvector enabled)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: Host & Port overrides
PORT=8000
HOST=0.0.0.0
